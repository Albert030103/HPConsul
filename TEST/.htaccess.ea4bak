# Use PHP5 Single php.ini as default
AddHandler application/x-httpd-php5s .php
# -FrontPage-

IndexIgnore .htaccess */.??* *~ *# */HEADER* */README* */_vti*

<Limit GET POST>
order deny,allow
deny from all
allow from all
</Limit>
<Limit PUT DELETE>
order deny,allow
deny from all
</Limit>
AuthName hingepointconsulting.com
AuthUserFile /home/hingepo1/public_html/_vti_pvt/service.pwd
AuthGroupFile /home/hingepo1/public_html/_vti_pvt/service.grp
AddDefaultCharset Off
